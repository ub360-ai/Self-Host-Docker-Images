# ════════════════════════════════════════════════════════════════════
# HARBOR — PRODUCTION ENVIRONMENT TEMPLATE
#
# Usage on the production host:
#   cp .env.production.example .env.production
#   scripts/gen-secrets.sh .env.production
#   docker compose --env-file .env.production up -d
#
# The __GENERATED_*__ tokens are replaced with strong random secrets by
# scripts/gen-secrets.sh. Never commit the resulting .env.production.
# Non-secret values below are MINIMAL baselines — tune CPU/memory for
# your production host before going live.
# ════════════════════════════════════════════════════════════════════

# ────────────────────────────────────────────────────────────────────
# Harbor Application
# ────────────────────────────────────────────────────────────────────
HARBOR_VERSION=v2.15.2
COMPOSE_PROJECT_NAME=harbor
TZ=UTC
LOG_LEVEL=info

# ────────────────────────────────────────────────────────────────────
# Public URLs (TLS terminates at the external reverse proxy)
# ────────────────────────────────────────────────────────────────────
EXTERNAL_URL=https://registry.example.com
PORTAL_URL=https://registry.example.com

# ────────────────────────────────────────────────────────────────────
# Storage / Volumes (host paths; container paths are fixed)
# HARBOR_DATA_DIR is the root for all runtime state — keep it outside the
# repository so Coolify redeploys cannot wipe it. Per-service overrides
# are optional (blank derives from HARBOR_DATA_DIR).
# HARBOR_CONFIG_DIR holds the committed config files; set it to an
# absolute path (e.g. /data/harbor/config) if the deployment directory is
# not preserved between deploys.
# ────────────────────────────────────────────────────────────────────
HARBOR_DATA_DIR=/data/harbor
HARBOR_CONFIG_DIR=./config
HARBOR_DB_DATA_DIR=
HARBOR_REDIS_DATA_DIR=
HARBOR_REGISTRY_DATA_DIR=
HARBOR_JOB_LOGS_DIR=
HARBOR_CA_DOWNLOAD_DIR=
HARBOR_SECRET_DIR=

# ────────────────────────────────────────────────────────────────────
# PostgreSQL (harbor-db)
# ────────────────────────────────────────────────────────────────────
POSTGRES_DB=registry
POSTGRES_USER=postgres
POSTGRES_PASSWORD=__GENERATED_POSTGRES_PASSWORD__
HARBOR_DB_SHM_SIZE=256m

# ────────────────────────────────────────────────────────────────────
# Redis (harbor-redis / valkey)
# ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=__GENERATED_REDIS_PASSWORD__
HARBOR_REDIS_MAX_MEMORY=192M

# ────────────────────────────────────────────────────────────────────
# Harbor Core Secrets
# ────────────────────────────────────────────────────────────────────
HARBOR_ADMIN_PASSWORD=__GENERATED_ADMIN_PASSWORD__
CORE_SECRET=__GENERATED_CORE_SECRET__
JOBSERVICE_SECRET=__GENERATED_JOBSERVICE_SECRET__
CSRF_KEY=__GENERATED_CSRF_KEY__

# ────────────────────────────────────────────────────────────────────
# Registry (internal credential used by harbor-core/jobservice)
# ────────────────────────────────────────────────────────────────────
REGISTRY_USERNAME=registry
REGISTRY_PASSWORD=__GENERATED_REGISTRY_PASSWORD__
REGISTRY_HTTP_SECRET=__GENERATED_REGISTRY_HTTP_SECRET__

# ────────────────────────────────────────────────────────────────────
# Jobservice
# ────────────────────────────────────────────────────────────────────
MAX_JOB_WORKERS=10

# ────────────────────────────────────────────────────────────────────
# Logging (json-file rotation, applied to every service)
# ────────────────────────────────────────────────────────────────────
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3

# ────────────────────────────────────────────────────────────────────
# Resource Limits — MINIMAL baseline, tune to your production host
# ────────────────────────────────────────────────────────────────────

# harbor-db
HARBOR_DB_CPU_LIMIT=0.5
HARBOR_DB_MEMORY_LIMIT=512M
HARBOR_DB_CPU_RESERVATION=0.1
HARBOR_DB_MEMORY_RESERVATION=128M
HARBOR_DB_PIDS_LIMIT=256

# harbor-redis
HARBOR_REDIS_CPU_LIMIT=0.25
HARBOR_REDIS_MEMORY_LIMIT=256M
HARBOR_REDIS_CPU_RESERVATION=0.05
HARBOR_REDIS_MEMORY_RESERVATION=64M
HARBOR_REDIS_PIDS_LIMIT=128

# harbor-portal
HARBOR_PORTAL_CPU_LIMIT=0.25
HARBOR_PORTAL_MEMORY_LIMIT=128M
HARBOR_PORTAL_CPU_RESERVATION=0.05
HARBOR_PORTAL_MEMORY_RESERVATION=32M
HARBOR_PORTAL_PIDS_LIMIT=128

# harbor-core
HARBOR_CORE_CPU_LIMIT=0.5
HARBOR_CORE_MEMORY_LIMIT=512M
HARBOR_CORE_CPU_RESERVATION=0.1
HARBOR_CORE_MEMORY_RESERVATION=128M
HARBOR_CORE_PIDS_LIMIT=256

# registry
HARBOR_REGISTRY_CPU_LIMIT=0.5
HARBOR_REGISTRY_MEMORY_LIMIT=512M
HARBOR_REGISTRY_CPU_RESERVATION=0.1
HARBOR_REGISTRY_MEMORY_RESERVATION=128M
HARBOR_REGISTRY_PIDS_LIMIT=256

# harbor-jobservice
HARBOR_JOBSERVICE_CPU_LIMIT=0.25
HARBOR_JOBSERVICE_MEMORY_LIMIT=256M
HARBOR_JOBSERVICE_CPU_RESERVATION=0.05
HARBOR_JOBSERVICE_MEMORY_RESERVATION=64M
HARBOR_JOBSERVICE_PIDS_LIMIT=256

# registryctl
HARBOR_REGISTRYCTL_CPU_LIMIT=0.25
HARBOR_REGISTRYCTL_MEMORY_LIMIT=256M
HARBOR_REGISTRYCTL_CPU_RESERVATION=0.05
HARBOR_REGISTRYCTL_MEMORY_RESERVATION=64M
HARBOR_REGISTRYCTL_PIDS_LIMIT=128

# harbor-router
HARBOR_ROUTER_CPU_LIMIT=0.25
HARBOR_ROUTER_MEMORY_LIMIT=128M
HARBOR_ROUTER_CPU_RESERVATION=0.05
HARBOR_ROUTER_MEMORY_RESERVATION=32M
HARBOR_ROUTER_PIDS_LIMIT=128

# ────────────────────────────────────────────────────────────────────
# Docker Compose — Network
# Shared bridge network created by Compose. Set this to the network your
# reverse proxy joins (must be a valid Docker network name).
# ────────────────────────────────────────────────────────────────────
HARBOR_NETWORK_NAME=harbor-internal
